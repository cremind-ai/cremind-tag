 *
 * PLACEHOLDER PINS. The Hema/Alibaba 52811 display mapping is UNVERIFIED
 * (hardware/matrix.yaml: pins unverified). These numbers are arbitrary: they
 * exist only so memory-fit builds link the SPI and panel drivers. The SPI bus
 * is `zephyr,deferred-init` and the panel is panel-id 255 (UNVERIFIED), so
 * firmware never configures or drives any of them. Replace every
 * HEMA_PLACEHOLDER_* value with measured pins before setting a real panel-id.
 */

#define HEMA_PLACEHOLDER_SCK	25
#define HEMA_PLACEHOLDER_MOSI	23
#define HEMA_PLACEHOLDER_CS	22
#define HEMA_PLACEHOLDER_DC	20
#define HEMA_PLACEHOLDER_RST	19
#define HEMA_PLACEHOLDER_BUSY	18

&pinctrl {
	spi0_default: spi0_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, HEMA_PLACEHOLDER_SCK)>,
				<NRF_PSEL(SPIM_MOSI, 0, HEMA_PLACEHOLDER_MOSI)>;
		};
	};

	spi0_sleep: spi0_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, HEMA_PLACEHOLDER_SCK)>,
				<NRF_PSEL(SPIM_MOSI, 0, HEMA_PLACEHOLDER_MOSI)>;
			low-power-enable;
		};
	};
};
