/*
 * nRF52840 DK gateway. No bootloader: the image links from 0 into
 * code_partition, which ends where the settings storage (mesh state, CDB,
 * names, assignments: the DK's 32 KiB storage_partition) begins, so the
 * linker refuses an image that would grow into it.
 */
/ {
	chosen {
		zephyr,code-partition = &code_partition;
	};
};

/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;

&flash0 {
	partitions {
		code_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "code";
			reg = <0x00000000 0x000f8000>;
		};
	};
};
