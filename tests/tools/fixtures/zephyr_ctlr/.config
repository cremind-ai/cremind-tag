#
# Synthetic excerpt of a resolved .config: Zephyr controller build (nRF51, tag)
#
CONFIG_SOC_SERIES_NRF51=y
CONFIG_SOC_NRF51822_QFAB=y
CONFIG_BT=y
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_LL_SW_SPLIT=y
CONFIG_BT_CTLR_CRYPTO_SUPPORT=y
CONFIG_BT_CTLR_CRYPTO=y
# Integer MPSL symbols stay visible with the Zephyr controller (firmware-notes section 1 trap)
CONFIG_MPSL_WORK_STACK_SIZE=1024
CONFIG_MPSL_THREAD_COOP_PRIO=8
# CONFIG_MPSL_FEM_ONLY is not set
CONFIG_SOC_FLASH_NRF=y
CONFIG_SOC_FLASH_NRF_RADIO_SYNC_TICKER=y
CONFIG_SOC_FLASH_NRF_RADIO_SYNC_MPSL_TIMESLOT_SESSION_COUNT=0
# CONFIG_SOC_FLASH_NRF_RADIO_SYNC_NONE is not set
# CONFIG_BT_LL_SOFTDEVICE is not set
