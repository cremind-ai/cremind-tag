# Cremind Tag firmware libraries (docs/firmware-libs.md). Applications enable
# only the libraries they link.

config CTAG_FRAME
	bool "Serial framing: COBS, CRC-32 frames, credits"
	select CTAG_CRC32
	help
	  COBS stream decoder, serial frame build/check (docs/protocol.md 1.1)
	  and credit accounting (1.3). Gateway and bridge maintenance port.

config CTAG_CBOR
	bool "Serial CBOR payload maps (zcbor)"
	select ZCBOR
	select ZCBOR_CANONICAL
	select CTAG_UTF8
	help
	  Canonical encode / strict decode of the integer-keyed CBOR maps carried
	  by serial frames. Gateway and bridge maintenance port.

config CTAG_LAYOUT
	bool "Layout validator, iterator and chunk assembler"
	help
	  Validation in the order of docs/protocol.md 4.3, the command iterator
	  and the LAYOUT_BEGIN/CHUNK/COMMIT assembler of 3.2-3.3. Bridge.

config CTAG_RENDER
	bool "Strip renderer, font-pack reader, QR"
	select CTAG_LAYOUT
	select CTAG_CRC32
	select CTAG_UTF8
	help
	  Bit-exact strip renderer (docs/protocol.md 4.4), font-pack reader
	  (docs/fontpack.md) and the vendored Nayuki qrcodegen v1.8.0. Bridge.

config CTAG_RENDER_QR_SLOTS
	int "QR symbols the renderer keeps across the strips of a frame"
	depends on CTAG_RENDER
	default 4
	range 1 4
	help
	  408 bytes of ctag_render_work each. With one per QR command
	  (docs/protocol.md 4.3 allows LAYOUT_MAX_QR = 4) every symbol is
	  encoded once per frame; with fewer the commands beyond the slots
	  share the last one and are re-encoded, with their remembered mask,
	  for every strip they reach.

config CTAG_FRAG
	bool "GATT fragmentation"
	help
	  Fragment encoder and reassembler of docs/protocol.md 5.3. Tag,
	  bridge and the gateway's own radio.

config CTAG_SCHED
	bool "Tag connection scheduler (the mesh suspend window)"
	help
	  The connection scheduler of docs/protocol.md 5.2: one connection
	  attempt at a time, each in its own mesh suspend window, the
	  rolling-minute rate limit, the per-tag back-off with its one quick
	  retry, and up to CTAG_SCHED_LINKS tag connections at once. Pure
	  logic: Bluetooth goes through struct sched_ops. Bridge and the
	  gateway's own radio (docs/protocol.md 11).

config CTAG_SCHED_LINKS
	int "Tag connections the scheduler holds at once"
	depends on CTAG_SCHED
	default 1
	range 1 4
	help
	  One struct sched_link each. The application sets it to its own
	  count (bridge: CTAG_BRIDGE_SESSIONS, gateway: CTAG_GW_TAG_LINKS)
	  and asserts that they match.

config CTAG_SCHED_TAGS
	int "Per-tag back-off entries"
	depends on CTAG_SCHED
	default 20
	range 1 64
	help
	  Tags whose last failure the scheduler remembers (12 bytes each);
	  when full, the entry expiring first is reused. The bridge keeps
	  one per assignable tag (CTAG_BRIDGE_MAX_TAGS).

config CTAG_SESSION
	bool "Tag session handshake and records"
	depends on PSA_CRYPTO
	select CTAG_CRYPTO_PSA
	help
	  Handshake state machines for the bridge and the tag, and record
	  seal/open (docs/protocol.md 5.4-5.5), over ctag_crypto.h with the PSA
	  backend. The lean PSA profile of docs/firmware-notes.md 12 suffices:
	  PSA_WANT_ALG_HMAC, PSA_WANT_ALG_SHA_256, PSA_WANT_ALG_CCM,
	  PSA_WANT_KEY_TYPE_AES, PSA_WANT_AES_KEY_SIZE_128,
	  PSA_WANT_KEY_TYPE_HMAC; nonces come from sys_csrand_get().

config CTAG_CRYPTO_PSA
	bool
	depends on PSA_CRYPTO

config CTAG_SECURE
	bool "Protocol v2 secure layer (Noise* IK, HACL*)"
	select CTAG_CRC32
	help
	  Device identity, the v2 key schedule, canonical grants and the
	  device-side grant rules, the ownership record, secure-message
	  framing, tunnel fragments and the responder-side secure endpoint
	  of docs/connect-setup.md, on the vendored Noise*
	  (Noise_IK_25519_ChaChaPoly_SHA256) and HACL* (X25519, Ed25519,
	  ChaCha20-Poly1305, SHA-256, HMAC) of lib/third_party. Gateway,
	  bridge and tag.

config CTAG_SECURE_HEAP_SIZE
	int "Secure heap for Noise* (bytes)"
	depends on CTAG_SECURE
	default 12288
	help
	  Noise* allocates its device, peer and session objects and a copy of
	  every message it seals or opens (KaRaMeL's KRML_HOST_MALLOC). They
	  live in this fixed sys_heap; a failed allocation fails the session,
	  never the device. Peak use is about 1.2 KiB for a session plus twice
	  the largest message sealed or opened at once (docs/firmware-libs.md).

config CTAG_TXN
	bool "Tag display transaction"
	select CTAG_CRC32
	help
	  FRAME_BEGIN decision table, boot recovery rule and the persisted
	  display record (docs/protocol.md 5.6, 6). Tag.

config CTAG_ENROLL
	bool "Enrollment blob parser"
	select CTAG_CRC32
	help
	  Parse and verify the 48-byte UICR enrollment blob (docs/protocol.md
	  9). Tag.

config CTAG_CRC32
	bool

choice CTAG_CRC32_IMPL
	prompt "CRC-32 implementation"
	depends on CTAG_CRC32
	default CTAG_CRC32_NIBBLE if CTAG_FRAME || CTAG_RENDER
	default CTAG_CRC32_BITWISE

config CTAG_CRC32_BITWISE
	bool "Bitwise, no table"
	help
	  Smallest; enough for the tag's enrollment blob and display record.

config CTAG_CRC32_NIBBLE
	bool "16-entry table"
	help
	  About four times faster than bitwise for 64 more bytes of flash:
	  font-pack index checks and serial frames.

config CTAG_CRC32_ZEPHYR
	bool "Zephyr's crc32_ieee_update()"
	select CRC
	help
	  Share Zephyr's CRC-32 when the application links crc32_ieee()
	  anyway.

endchoice

config CTAG_UTF8
	bool
